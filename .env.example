DATABASE_URL="mysql://boogle:boogle@localhost:3306/boogle"
PORT=8080
API_PUBLIC_URL=http://localhost:8080
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CLOUDFRONT_BASE_URL=
AWS_S3_SIGNED_URL_EXPIRES_IN=3600

# 로그인 시작 시 선택할 수 있는 프론트 Origin 허용 목록 (쉼표 구분)
FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.example.com
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/oauth/callback
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me
OAUTH_STATE_EXPIRES_IN=600s
OAUTH_RESULT_EXPIRES_IN=60s
ACCOUNT_LINK_TOKEN_EXPIRES_IN=5m
AUTH_TEMPORARY_TOKEN_RETENTION=7d
AUTH_TEMPORARY_TOKEN_CLEANUP_INTERVAL=1h
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=14d

# Production OAuth redirect URIs:
# API_PUBLIC_URL=https://api.glgc.cloud
# GOOGLE_REDIRECT_URI=https://api.glgc.cloud/api/v1/auth/oauth/google/callback
# KAKAO_REDIRECT_URI=https://api.glgc.cloud/api/v1/auth/oauth/kakao/callback

# Web Push (FCM) — 토큰 등록 API(1단계)는 없어도 동작. 발송(2단계)에서 필요.
# 서비스 계정 키는 시크릿이므로 실제 값은 배포 env로만 주입(레포에 커밋 금지).
FIREBASE_SERVICE_ACCOUNT_BASE64=   # 서비스 계정 JSON을 Base64 인코딩한 값 (백엔드 발송용)
FIREBASE_VAPID_KEY=                # 웹 푸시 VAPID 공개키 (주로 프론트 토큰 발급용)

# 알림 테스트 발송 API(POST /notifications/test) 활성화 여부.
# 기본 비활성. 프론트 수신 확인이 필요한 기간에만 'true'로 켠다.
NOTIFICATION_TEST_ENABLED=false
